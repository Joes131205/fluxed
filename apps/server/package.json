{
    "name": "@app/server",
    "main": "src/index.ts",
    "types": "src/index.ts",
    "scripts": {
        "build": "tsdown --outDir dist",
        "check-types": "tsc -b",
        "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
        "dev": "bun run --hot src/index.ts",
        "start": "bun run dist/index.js"
    },
    "dependencies": {
        "@hono/zod-validator": "^0.7.6",
        "argon2": "^0.44.0",
        "axios": "~1.13.6",
        "hono": "^4.12.5",
        "jsonwebtoken": "^9.0.3",
        "zod": "^4.3.5"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.6.0",
        "tsdown": "^0.14.1",
        "typescript": "^5.8.2"
    }
}

{
    "installCommand": "bun install",
    "buildCommand": "cd apps/web && VITE_API_URL=https://$VERCEL_URL bun run build",
    "outputDirectory": "apps/web/dist",
    "routes": [
        { "src": "/api(/?|/.*)", "dest": "/api/[[...route]]" },
        { "src": "/(?!api).*\\.(?:js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)$", "headers": { "cache-control": "public, max-age=31536000" } },
        { "src": "/.*", "dest": "/index.html" }
    ]
}

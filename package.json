{
    "name": "boilerplate4",
    "devDependencies": {
        "@types/bun": "latest",
        "turbo": "^2.8.14",
        "typescript": "^5.9.3"
    },
    "packageManager": "bun@1.3.4",
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/*",
        "apps/packages/*"
    ],
    "scripts": {
        "dev": "turbo dev",
        "build": "turbo build",
        "lint": "turbo lint",
        "clean": "turbo clean",
        "db:generate": "turbo run db:generate",
        "db:migrate": "turbo run db:migrate",
        "db:studio": "turbo run db:studio"
    }
}

{
    "name": "boilerplate4",
    "devDependencies": {
        "@types/bun": "latest",
        "turbo": "^2.9.4",
        "typescript": "^5.9.3"
    },
    "packageManager": "bun@1.3.4",
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/mobile",
        "apps/server/apps/*"
    ],
    "scripts": {
        "build": "turbo build",
        "lint": "turbo lint",
        "clean": "turbo clean",
        "db:generate": "turbo run db:generate",
        "db:migrate": "turbo run db:migrate",
        "db:studio": "turbo run db:studio",
        "dev": "bun run db:generate && turbo run dev --filter=\"./apps/mobile\" --filter=\"./apps/server/apps/*\""
    },
    "overrides": {
        "axios": "~1.13.6"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.8.0",
        "@react-native-vector-icons/fontawesome6": "^13.1.1",
        "pg": "^8.16.3"
    }
}
